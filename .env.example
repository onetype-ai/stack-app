# Where the site is served: canonical links, sitemap.xml and robots.txt. Required by `pnpm build`.
SITE_ORIGIN=http://localhost:7380

# Public: every VITE_ value ships in the bundle. A name that reads like a secret refuses the build.
VITE_API_URL=/api
# VITE_WS_URL=ws://localhost:7280/ws
VITE_LOG_LEVEL=info
