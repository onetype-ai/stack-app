{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": [
            "vite/client",
            "node"
        ],
        "paths": {
            "@ui": [
                "./src/ui/index.ts"
            ],
            "@ui/*": [
                "./src/ui/*"
            ],
            "@plugins/*": [
                "./src/plugins/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "*.ts",
        "*.tsx"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
